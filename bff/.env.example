# UOI Customer Portal BFF — environment configuration
# Copy this file to `.env` and fill in the credentials. NEVER commit `.env`
# to source control; it is excluded by .gitignore.

# ── InsureMO Identity Provider ────────────────────────────────────────────────
# The auth endpoint that issues the service-account bearer token.
UOI_AUTH_BASE_URL=https://uoisitws-sandbox-sg.insuremo.com
UOI_AUTH_PATH=/api/platform/v1/json/tickets

# ── InsureMO Data Plane ───────────────────────────────────────────────────────
# Base URL + path prefix for every data endpoint
# (fetchOrderData, findIssuedPolicies, dms/file/upload, email/send, etc.).
UOI_DATA_BASE_URL=https://sandbox-sg-gw.insuremo.com
UOI_DATA_API_PREFIX=/uoisitws/v1/uoi-bff-app

# ── Service-account credentials ───────────────────────────────────────────────
# Used only by this BFF to acquire the bearer token at startup. The token
# itself is held in process memory and refreshed automatically; the
# username/password never leave the server.
UOI_USERNAME=
UOI_PASSWORD=

# ── Networking ────────────────────────────────────────────────────────────────
# Per-request timeout (seconds) for upstream calls.
UOI_TIMEOUT_S=10.0
